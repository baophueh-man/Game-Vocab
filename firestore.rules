rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Functions
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    function isValidOptionalString(field, minLen, maxLen) {
      return !(field in request.resource.data) ||
             (request.resource.data[field] is string &&
              request.resource.data[field].size() >= minLen &&
              request.resource.data[field].size() <= maxLen);
    }

    function isValidWordsList(wordsList) {
      return wordsList is list && wordsList.size() <= 100;
    }

    function isValidWordSet() {
      return hasRequiredFields(['id', 'title', 'words', 'createdAt']) &&
             validStringLength('id', 1, 100) &&
             validStringLength('title', 1, 100) &&
             isValidOptionalString('description', 0, 500) &&
             request.resource.data.createdAt is number &&
             isValidWordsList(request.resource.data.words);
    }

    match /wordSets/{setId} {
      allow read: if true;
      allow create, update: if isValidWordSet() && request.resource.data.id == setId;
      allow delete: if true;
    }

    match /audioFiles/{audioId} {
      allow read: if true;
      allow create, update: if hasRequiredFields(['id', 'data']) &&
                               validStringLength('id', 1, 100) &&
                               validStringLength('data', 1, 1048576) &&
                               request.resource.data.id == audioId;
      allow delete: if true;
    }

    match /imageFiles/{imageId} {
      allow read: if true;
      allow create, update: if hasRequiredFields(['id', 'data']) &&
                               validStringLength('id', 1, 100) &&
                               request.resource.data.id == imageId;
      allow delete: if true;
    }
  }
}
